    "X opens. Three in a row — across, down or corner to corner — wins." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X başlar. Yatay, dikey ya da çapraz üçü yan yana getiren kazanır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X beginnt. Drei in einer Reihe – waagerecht, senkrecht oder diagonal – gewinnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X commence. Trois alignés — en ligne, en colonne ou en diagonale — et c'est gagné."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza X. Tres en línea — horizontal, vertical o diagonal — ganan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X começa. Três em linha — na horizontal, vertical ou diagonal — vencem."
