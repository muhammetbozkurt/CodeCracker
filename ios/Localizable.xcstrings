    "Every game counted so far is forgotten. This cannot be undone." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdiye kadar sayılan tüm oyunlar silinir. Bu işlem geri alınamaz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle bisher gezählten Spiele werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les parties comptées jusqu'ici seront oubliées. Cette action est irréversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se olvidarán todas las partidas contadas hasta ahora. Esto no se puede deshacer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as partidas contadas até agora serão esquecidas. Isso não pode ser desfeito."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le partite contate finora verranno dimenticate. L'operazione è irreversibile."
          }
        }
      }
    },
    "Finish a game and it shows up here — wins, losses and your best run, for every way you play." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oyunu bitir, burada görünsün: her oyun şekli için galibiyetlerin, mağlubiyetlerin ve en iyi serin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende ein Spiel und es erscheint hier – Siege, Niederlagen und deine beste Serie, für jede Spielart."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine une partie et elle apparaîtra ici : victoires, défaites et meilleure série, pour chaque mode de jeu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una partida y aparecerá aquí: victorias, derrotas y tu mejor racha, en cada modo de juego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine uma partida e ela aparece aqui: vitórias, derrotas e sua melhor sequência, em cada modo de jogo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finisci una partita e comparirà qui: vittorie, sconfitte e la tua serie migliore, per ogni modalità."
          }
        }
      }
    },
