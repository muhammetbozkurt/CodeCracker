    "You and the computer each hide a four-digit code with no repeated digits, then take turns guessing the other's." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen ve bilgisayar, rakamları tekrarsız dört haneli birer kod saklarsınız; sonra sırayla birbirinizinkini tahmin edersiniz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du und der Computer versteckt je einen vierstelligen Code ohne doppelte Ziffern und ratet dann abwechselnd den des anderen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toi et l'ordinateur cachez chacun un code à quatre chiffres sans répétition, puis devinez à tour de rôle celui de l'autre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú y la máquina esconden cada uno un código de cuatro dígitos sin repetir y luego se turnan para adivinar el del otro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você e o computador escondem cada um um código de quatro dígitos sem repetição e depois se revezam tentando adivinhar o do outro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu e il computer nascondete ciascuno un codice di quattro cifre senza ripetizioni, poi a turno cercate di indovinare quello dell'altro."
          }
        }
      }
    },
    "You cracked it" : {
      "localizations" : {
